<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Security Groups -->
        <record id="group_mp_user" model="res.groups">
            <field name="name">M and P User</field>
        </record>

        <record id="group_mp_manager" model="res.groups">
            <field name="name">M and P Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_mp_user'))]"/>
        </record>

        <record id="group_mp_integration_admin" model="res.groups">
            <field name="name">M and P Integration Administrator</field>
            <field name="implied_ids" eval="[(4, ref('group_mp_manager'))]"/>
        </record>
    </data>
</odoo>

