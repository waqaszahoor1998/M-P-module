<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend stock picking form to show M&P fields -->
    <record id="view_picking_form_mp" model="ir.ui.view">
        <field name="name">stock.picking.form.mp</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Add M&P section in Additional Info tab -->
            <xpath expr="//page[@name='extra']" position="inside">
                <group string="M and P Logistics Information" col="2">
                    <group>
                        <field name="mp_logistics_operation_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="mp_tracking_number" readonly="True"/>
                        <field name="estimated_delivery_date"/>
                    </group>
                    <group>
                        <field name="is_cross_warehouse_transfer" readonly="True"/>
                        <field name="source_warehouse_id" readonly="True"/>
                        <field name="dest_warehouse_id" readonly="True"/>
                    </group>
                </group>
            </xpath>
            
            <!-- Add M&P tracking in shipping information -->
            <xpath expr="//field[@name='carrier_tracking_ref']" position="after">
                <field name="mp_tracking_number" string="M and P Tracking" readonly="True"/>
            </xpath>
        </field>
    </record>

    <!-- Extend stock picking list view to show M&P operation -->
    <record id="view_picking_tree_mp" model="ir.ui.view">
        <field name="name">stock.picking.tree.mp</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='carrier_id']" position="after">
                <field name="mp_logistics_operation_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>

