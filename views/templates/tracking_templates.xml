<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="tracking_result" name="M&amp;P Tracking Result">
        <t t-call="website.layout">
            <t t-set="title">M&amp;P Shipment Tracking</t>
            <div class="container mt-4">
                <div class="row">
                    <div class="col-12">
                        <h2>M&amp;P Shipment Tracking</h2>
                        <div class="card mt-3">
                            <div class="card-header">
                                <h5>Tracking Number: <strong><t t-esc="tracking_number"/></strong></h5>
                            </div>
                            <div class="card-body">
                                <t t-if="tracking_info">
                                    <div class="alert alert-success">
                                        <h6>Tracking Information</h6>
                                        <pre style="white-space: pre-wrap; word-wrap: break-word;"><t t-esc="tracking_info"/></pre>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="alert alert-info">
                                        <p>Tracking information retrieved successfully.</p>
                                        <p>For detailed tracking, please contact M&amp;P Logistics.</p>
                                    </div>
                                </t>
                            </div>
                        </div>
                        <div class="mt-3">
                            <a href="/" class="btn btn-primary">Back to Home</a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="tracking_error" name="M&amp;P Tracking Error">
        <t t-call="website.layout">
            <t t-set="title">M&amp;P Tracking Error</t>
            <div class="container mt-4">
                <div class="row">
                    <div class="col-12">
                        <h2>M&amp;P Shipment Tracking</h2>
                        <div class="card mt-3">
                            <div class="card-header bg-danger text-white">
                                <h5>Error</h5>
                            </div>
                            <div class="card-body">
                                <div class="alert alert-danger">
                                    <h6>Unable to retrieve tracking information</h6>
                                    <p><strong>Tracking Number:</strong> <t t-esc="tracking_number"/></p>
                                    <p><strong>Error:</strong> <t t-esc="error"/></p>
                                </div>
                                <p>Please verify the tracking number and try again, or contact M&amp;P Logistics for assistance.</p>
                            </div>
                        </div>
                        <div class="mt-3">
                            <a href="/" class="btn btn-primary">Back to Home</a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>

